rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAnalyst() {
      return isSignedIn() && (
        request.auth.token.role == 'analyst' ||
        exists(/databases/$(database)/documents/analysts/$(request.auth.uid))
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection: strictly owner or verified analyst
    match /users/{userId} {
      allow get: if isOwner(userId) || isAnalyst();
      allow list: if isAnalyst();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAnalyst();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Savings Goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Analyst Queue: strictly readable and writable only by analysts
    match /analyst_queue/{itemId} {
      allow read, write: if isAnalyst();
    }

    // 3. Analysts Directory
    match /analysts/{analystId} {
      allow read: if isAnalyst();
      allow write: if false;
    }

    // 4. Guardian Alerts: strictly owner, guardian, or analyst
    match /guardian_alerts/{alertId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.guardianId == request.auth.uid ||
        isAnalyst()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.guardianId == request.auth.uid ||
        isAnalyst()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.guardianId == request.auth.uid ||
        isAnalyst()
      );
    }
  }
}
