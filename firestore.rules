rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAnalyst() {
      return isSignedIn() && (
        request.auth.token.role == 'analyst' ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/analysts/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Disallow client writes to sensitive financial, credential, or risk fields
    function hasNoRestrictedUserFields(data) {
      return !('balance' in data) &&
             !('pin' in data) &&
             !('pinHash' in data) &&
             !('pinSalt' in data) &&
             !('riskScore' in data) &&
             !('riskLevel' in data) &&
             (!('role' in data) || data.role == 'user');
    }

    function doesNotModifyRestrictedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'balance',
        'pin',
        'pinHash',
        'pinSalt',
        'role',
        'riskScore',
        'riskLevel'
      ]);
    }

    function hasNoRestrictedTransactionFields(data) {
      return !('balance' in data) &&
             !('pin' in data) &&
             !('pinHash' in data) &&
             !('riskScore' in data) &&
             !('riskLevel' in data) &&
             !('riskSignals' in data);
    }

    // Default Deny across the entire database
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection: strictly owner only; clients cannot write balance/pin/risk/role fields
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasNoRestrictedUserFields(request.resource.data);
      allow update: if isOwner(userId) && doesNotModifyRestrictedUserFields();
      allow delete: if false;

      // Transactions subcollection: owner or read-only analyst; clients cannot write balance/pin/risk fields
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAnalyst();
        allow create: if isOwner(userId) &&
                      request.resource.data.userId == userId &&
                      hasNoRestrictedTransactionFields(request.resource.data);
        allow update, delete: if false;
      }

      // Savings Goals subcollection: strictly owner only; cannot write balance/pin/risk fields
      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                      request.resource.data.userId == userId &&
                      hasNoRestrictedUserFields(request.resource.data);
        allow update: if isOwner(userId) &&
                      resource.data.userId == userId &&
                      request.resource.data.userId == userId &&
                      doesNotModifyRestrictedUserFields();
        allow delete: if isOwner(userId);
      }
    }

    // 2. Analyst Queue: strictly analysts only
    match /analyst_queue/{itemId} {
      allow read, write: if isAnalyst();
    }

    // 3. Analysts & Admins Directories
    match /analysts/{analystId} {
      allow read: if isAnalyst();
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 4. Guardian Alerts: strictly owner (userId) or invited guardian (guardianId) only
    match /guardian_alerts/{alertId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.guardianId == request.auth.uid
      );
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    hasNoRestrictedUserFields(request.resource.data);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.guardianId == request.auth.uid
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userId',
        'guardianId',
        'amount',
        'balance',
        'pin',
        'pinHash',
        'riskScore',
        'riskLevel'
      ]);
      allow delete: if false;
    }

    // 5. Governed Fraud Blocklist (SHA-256 phone hashes): admin-only add/remove
    match /fraud_blocklist/{phoneHash} {
      allow get, list: if isAnalyst() || isAdmin();
      allow create, update: if isAdmin() &&
                            request.resource.data.phoneHash == phoneHash &&
                            request.resource.data.phoneHash.matches('^[a-f0-9]{64}$');
      allow delete: if isAdmin();
    }
  }
}
