{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated MFS user profile. Clients cannot write balance, pin, pinHash, role, or risk fields.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "analyst", "admin", "guardian"] },
        "balance": { "type": "number" },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "simpleMode": { "type": "boolean" },
        "aiConsentGiven": { "type": "boolean" },
        "guardianPhone": { "type": "string", "maxLength": 20 },
        "guardianName": { "type": "string", "maxLength": 100 },
        "guardianStatus": { "type": "string", "enum": ["none", "pending", "connected"] }
      },
      "required": ["name", "phone", "role", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents an individual financial transaction owned by uid; analysts have read-only access.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["send_money", "cash_out", "mobile_recharge", "pay_bill", "add_money", "savings"] },
        "recipient": { "type": "string", "maxLength": 60 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "total": { "type": "number" },
        "note": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryEn": { "type": "string", "maxLength": 50 },
        "roundUpAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "flagged", "blocked", "in_review"] },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "type", "recipient", "amount", "total", "category", "status", "timestamp"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Micro-savings and target goal records private to the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "durationMonths": { "type": "number" },
        "monthlySavings": { "type": "number" },
        "roundUpActive": { "type": "boolean" },
        "category": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "targetAmount", "currentAmount"]
    },
    "AnalystQueueItem": {
      "title": "AnalystQueueItem",
      "description": "Flagged high-risk transaction cases strictly restricted to verified fraud analysts",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 20 },
        "recipientPhone": { "type": "string", "maxLength": 20 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed", "escalated"] },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["transactionId", "userName", "userPhone", "amount", "riskScore", "status", "timestamp"]
    },
    "GuardianAlert": {
      "title": "GuardianAlert",
      "description": "High-risk alert records accessible only to the ward owner or invited guardian",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "guardianId": { "type": "string", "maxLength": 128 },
        "guardianPhone": { "type": "string", "maxLength": 20 },
        "wardName": { "type": "string", "maxLength": 100 },
        "wardPhone": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["medium", "high"] },
        "timestamp": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "acknowledged", "warned"] },
        "adviceBn": { "type": "string", "maxLength": 300 }
      },
      "required": ["userId", "guardianId", "guardianPhone", "wardName", "amount", "riskScore", "status", "timestamp"]
    },
    "FraudBlocklistEntry": {
      "title": "FraudBlocklistEntry",
      "description": "Governed SHA-256 phone hash blocklist entry managed exclusively by admins",
      "type": "object",
      "properties": {
        "phoneHash": { "type": "string", "maxLength": 64 },
        "maskedPhone": { "type": "string", "maxLength": 20 },
        "source": { "type": "string", "enum": ["bangladesh_bank_alert", "analyst_escalation", "community_verified", "mfs_federated_feed"] },
        "addedBy": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string", "maxLength": 40 },
        "version": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "reason": { "type": "string", "maxLength": 300 }
      },
      "required": ["phoneHash", "source", "addedBy", "addedAt", "version", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document; only owner can read/update non-sensitive preferences; balance/pin/risk fields are server-only"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Subcollection of transactions private to the owner; analysts have read-only access"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Subcollection of financial goals private to the owner"
    },
    "/analyst_queue/{itemId}": {
      "schema": { "$ref": "#/entities/AnalystQueueItem" },
      "description": "Queue of suspicious cases accessible exclusively to verified fraud analysts"
    },
    "/guardian_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/GuardianAlert" },
      "description": "Alerts accessible exclusively to the ward owner or invited guardian"
    },
    "/fraud_blocklist/{phoneHash}": {
      "schema": { "$ref": "#/entities/FraudBlocklistEntry" },
      "description": "Governed collection of SHA-256 phone hashes; admin-only write access"
    }
  }
}
